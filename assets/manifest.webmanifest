{
  "name": "Orbit — habit chart",
  "short_name": "Orbit",
  "description": "A hand-inked celestial habit and productivity chart. Offline, private, no accounts.",
  "id": "../",
  "start_url": "../index.html",
  "scope": "../",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2EFE4",
